name: Scheduled Fork Sync

on:
  push:
  schedule:
    - cron: '0 */3 * * *'
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout target repo
        uses: actions/checkout@v4
        with:
          persist-credentials: false

      - name: Sync upstream changes and protect sync.yml
        env:
          UPSTREAM_URL: "https://github.com/mtvpls/MoonTVPlus.git"
          TARGET_BRANCH: "main"
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "41898282+github-actions[bot]@users.noreply.github.com"
          
          # 1. 添加上游并拉取
          git remote add upstream "$UPSTREAM_URL"
          git fetch upstream
          git checkout "$TARGET_BRANCH"
          
          # 2. 正常合并上游更新
          git merge "upstream/$TARGET_BRANCH" --allow-unrelated-histories -m "Auto sync with upstream" || true
          
          # 3. 关键保护：强制检出（恢复）本地的 sync.yml，确保它绝对不会被上游冲掉或删掉
          git checkout HEAD -- .github/workflows/sync.yml || true
          
          # 4. 如果 sync.yml 刚才有未暂存的修改，把它加进本次提交
          git add .github/workflows/sync.yml || true
          
          # 如果有变更需要提交，再做一次 commit
          git commit -m "Protect sync.yml from upstream overwrite" || echo "No changes to commit"
          
          # 5. 推送到自己的仓库
          git push https://${{ secrets.SYNC_TOKEN }}@github.com/${{ github.repository }}.git "$TARGET_BRANCH"
